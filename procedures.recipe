RECIPE SpicyRice
SERVES 4
INGREDIENT rice = 2 cups
INGREDIENT oil = 2 tbsp
INGREDIENT cumin = 1 tsp
INGREDIENT chili = 1 tsp
INGREDIENT salt = 1 tsp

DEFINE tempering(spice)
  STEP add(spice)
  STEP stir()
END

DEFINE simmer(duration)
  STEP cook(duration)
  STEP stir()
END

STEP heat_pan()
STEP add(oil)
CALL tempering(cumin)
CALL tempering(chili)
STEP add(rice)
STEP add(salt)
CALL simmer(15 minutes)
STEP serve()
